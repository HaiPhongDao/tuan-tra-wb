<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2B24"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvAlarmIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏰"
        android:textSize="72sp" />

    <TextView
        android:id="@+id/tvAlertHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="ĐẾN GIỜ TUẦN TRA!"
        android:textColor="#8BE3C3"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNextPoint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Điểm kế tiếp: Sảnh A"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStaffName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Nhân viên tuần tra"
        android:textColor="#A0B8AD"
        android:textSize="16sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <!-- Button Open App -->
    <Button
        android:id="@+id/btnOpenApp"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:backgroundTint="#0F7A62"
        android:text="🚀 MỞ ỨNG DỤNG TUẦN TRA"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Button Dismiss / Stop Sound -->
    <Button
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#B24B12"
        android:text="🔕 Tắt Chuông"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>
